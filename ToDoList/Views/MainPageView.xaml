<Page x:Class="ToDoList.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:ToDoList.Views"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="MainPage">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0 0 0 5">
            <Button Content="Adicionar" Padding="3" Margin="0 0 5 0" Click="Button_Click"/>
            <Button Content="Editar" Padding="3" Margin="5 0"/>
            <Button Content="Excluir" Padding="3" Margin="5 0"/>
        </StackPanel>

        <ListBox ItemsSource="{Binding Tarefas}" Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="Gray" BorderThickness="0,0,0,1" Padding="10">
                        <StackPanel >
                            <CheckBox IsChecked="{Binding Concluida}" Content="Concluida"/>

                            <TextBlock>
                               <Run Text="Titulo: "/>
                               <Run Text="{Binding Titulo}"/>
                            </TextBlock>

                            <TextBlock>
                                <Run Text="Descrição: "/>
                                <Run Text="{Binding Descricao}"/>
                            </TextBlock>

                            <TextBlock>
                                <Run Text="Data de criação: "/>
                                <Run Text="{Binding DataCriacao}"/>
                            </TextBlock>

                            <TextBlock>
                                <Run Text="Prioridade: "/>
                                <Run Text="{Binding Prioridade}"/>
                            </TextBlock>

                            <TextBlock>
                                <Run Text="Categoria: "/>
                                <Run Text="{Binding Categoria.Nome}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
